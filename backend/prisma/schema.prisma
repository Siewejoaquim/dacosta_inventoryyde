generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum InvoiceStatus {
  PAID
  UNPAID
  PARTIAL
  VOID
}

enum StockAction {
  INCREASE
  DECREASE
  ADJUSTMENT
}

enum RequestStatus {
  PENDING
  FULFILLED
}

model User {
  id        String     @id @default(uuid())
  name      String
  username  String     @unique
  password  String
  role      Role       @default(STAFF)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  invoices       Invoice[]
  expenses       Expense[]
  stockHistory   StockHistory[]
  productRequests ProductRequest[]
}

model Product {
  id              String   @id @default(uuid())
  productName     String
  category        String
  supplier        String?
  quantityInStock Int      @default(0)
  purchasePrice   Float    @default(0)
  sellingPrice    Float
  reorderPoint    Int      @default(5)
  description     String?
  isArchived      Boolean  @default(false)
  dateAdded       DateTime @default(now())
  lastUpdated     DateTime @updatedAt

  invoiceItems    InvoiceItem[]
  stockHistory    StockHistory[]
  productRequests ProductRequest[]
}

model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique
  customerName   String
  customerPhone  String?
  totalAmount    Float
  originalAmount Float?
  amountPaid     Float         @default(0)
  status         InvoiceStatus @default(UNPAID)
  guarantee      String?       // e.g. "1 semaine", "1 mois", "6 mois", "1 an"
  dateCreated    DateTime      @default(now())
  voidedAt       DateTime?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  voidedById String?

  items InvoiceItem[]
}

model InvoiceItem {
  id          String  @id @default(uuid())
  productName String
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  guarantee   String? // per-item guarantee override

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])
}

model Expense {
  id          String   @id @default(uuid())
  description String
  amount      Float
  category    String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  loggedById String
  loggedBy   User   @relation(fields: [loggedById], references: [id])
}

model StockHistory {
  id        String      @id @default(uuid())
  action    StockAction
  quantity  Int
  note      String?
  createdAt DateTime    @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  performedById String
  performedBy   User   @relation(fields: [performedById], references: [id])
}

model ProductRequest {
  id          String        @id @default(uuid())
  productName String
  description String?
  customerName String?
  status      RequestStatus @default(PENDING)
  date        DateTime      @default(now())

  loggedById String
  loggedBy   User   @relation(fields: [loggedById], references: [id])

  fulfilledByProductId String?
  fulfilledByProduct   Product? @relation(fields: [fulfilledByProductId], references: [id])
}
